# Copia este archivo como .env y completa AZDO_PAT localmente.
AZDO_ORG_URL=https://dev.azure.com/GSID-Autogestion
AZDO_PROJECT=Pruebas-TI IA
AZDO_PAT=pega_aqui_tu_PAT
# Agente que ejecuta el flujo de QA: claude (Claude Code) o agy (Antigravity CLI).
QA_AGENT=claude
# Opcional: ruta real a claude si no está en PATH. Si falta, se usa el binario de la extensión de VS Code/Antigravity.
# CLAUDE_COMMAND=C:\\Users\\tu-usuario\\.local\\bin\\claude.exe
# Opcional: modelo de Claude (alias como sonnet u opus, o el nombre completo).
# CLAUDE_MODEL=sonnet
# Ejecución funcional: playwright (híbrido: el agente genera el spec una vez y Playwright lo ejecuta en segundos)
# o agent (el agente ejecuta cada paso con MCP Playwright; más lento).
QA_EXECUTION_MODE=playwright
# Opcional: workers de Playwright (los navegadores corren en paralelo; los casos de un spec, solo si declara mode 'parallel').
# QA_WORKERS=4
# Opcional: off desactiva el triage automático de fallos con el agente en modo híbrido.
# QA_TRIAGE=on
# Opcional: generación del script por lotes. Cada agente genera QA_GENERATION_BATCH_SIZE casos (6 por defecto),
# hasta QA_GENERATION_PARALLEL agentes a la vez (3), con QA_GENERATION_BUDGET_MS por lote (600000 = 10 min).
# Si las pantallas son lentas o muy grandes, baja el tamaño del lote antes que subir el tiempo.
# QA_GENERATION_BATCH_SIZE=6
# QA_GENERATION_PARALLEL=3
# QA_GENERATION_BUDGET_MS=600000
# Opcional: reintentos por caso fallido (1 por defecto). Un caso que pasa al reintentar se reporta como intermitente (FLAKY).
# QA_RETRIES=1
# Opcional: permisos del agente Claude. Por defecto solo escribe en 3-outputs/ y solo ejecuta Playwright y Lighthouse.
# unrestricted vuelve a --dangerously-skip-permissions (no recomendado).
# QA_AGENT_PERMISSIONS=restricted
# Opcional: dominios adicionales a los que un spec puede navegar (separados por coma), p. ej. un SSO externo.
# QA_ALLOWED_HOSTS=login.microsoftonline.com
# Sesiones de login (SSO/MFA) guardadas con: node tools/save-session.mjs <url> NOMBRE_STORAGE_STATE
# El script añade la línea automáticamente, p. ej.:
# SIDERA_BUYER_STORAGE_STATE=.auth/sidera_buyer.json
# Credenciales de prueba (las pruebas las leen con process.env; nunca se escriben en specs ni reportes):
# SIDERA_PROVIDER_EMAIL=
# SIDERA_PROVIDER_PASSWORD=
# Opcional: ruta real al ejecutable si agy no está en PATH.
# AGY_COMMAND=C:\\Users\\tu-usuario\\AppData\\Roaming\\npm\\agy.cmd
